<settings>
    <setting propertyKey="@Properties.apiKey" title="@Strings.SettingApiKey" prompt="@Strings.SettingApiKeyPrompt">
        <settingConfig type="alphaNumeric" maxLength="24" />
    </setting>
    <setting propertyKey="@Properties.searchRadius" title="@Strings.SettingRadius">
        <settingConfig type="numeric" min="1" max="50" />
    </setting>
    <setting propertyKey="@Properties.daysBack" title="@Strings.SettingDays">
        <settingConfig type="numeric" min="1" max="30" />
    </setting>
</settings>